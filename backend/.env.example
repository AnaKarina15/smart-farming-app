# Aplicacion
APP_NAME=AgroField API
APP_VERSION=0.1.0
APP_PORT=3000
APP_API_PREFIX=api/v1
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=agrofield_db

# JWT - Usa secretos largos y aleatorios en produccion
JWT_ACCESS_SECRET=cambia-esto-por-secreto-largo-y-aleatorio-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Origenes permitidos separados por coma (vacio = permitir todos en dev)
CORS_ORIGINS=

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
